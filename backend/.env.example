# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Production Database: Neon Serverless PostgreSQL (Get free connection string from https://neon.tech)
# Use the pooled Neon URL for application queries and the direct URL for migrations.
DATABASE_URL="postgresql://caresync:local_password@localhost:5432/caresync"
DIRECT_URL="postgresql://caresync:local_password@localhost:5432/caresync"

# JWT Secret
JWT_SECRET="" # Render generates a unique secret for the hosted API

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Google Gemini LLM API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Email Configuration (Nodemailer - auto fallback to Ethereal if left empty)
EMAIL_DISABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Healthcare App <no-reply@healthcareapp.com>"

# Google Calendar OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN=""

# Backend Server Configuration
PORT=5000
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/healthcaredb
JWT_SECRET="healthcare-jwt-secret-key-2026"

# Google Gemini LLM Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Configuration (Nodemailer / SendGrid / Mailgun / Ethereal)
# Leave SMTP_HOST empty to auto-generate Ethereal test mailbox credentials in dev console!
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Healthcare App <no-reply@healthcareapp.com>"

# Google Calendar API OAuth 2.0 (Optional - system degrades gracefully with mock link if not configured)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Production Database: Neon Serverless PostgreSQL (Get free connection string from https://neon.tech)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Use the pooled Neon URL for application queries and the direct URL for migrations.
DATABASE_URL="postgresql://caresync:local_password@localhost:5432/caresync"
DIRECT_URL="postgresql://caresync:local_password@localhost:5432/caresync"

# JWT Authentication Secret
JWT_SECRET="" # Render generates a unique secret for the hosted API

# Frontend Application Origin (For Production CORS)
FRONTEND_URL="https://your-frontend-domain.vercel.app"

# Google Gemini LLM Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Configuration (Nodemailer / SendGrid / Mailgun / Ethereal)
# Leave SMTP_HOST empty to auto-generate Ethereal test mailbox credentials in dev console!
EMAIL_DISABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Healthcare App <no-reply@healthcareapp.com>"

# Google Calendar API OAuth 2.0 (Optional - system degrades gracefully with mock link if not configured)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
